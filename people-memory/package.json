{
  "name": "people-memory",
  "private": true,
  "version": "0.1.0",
  "description": "AI人脈アシスタント PWA MVP（ローカルファースト）",
  "type": "module",
  "scripts": {
    "copy-models": "node scripts/copy-models.mjs",
    "predev": "npm run copy-models",
    "dev": "vite --host",
    "prebuild": "npm run copy-models",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node scripts/e2e-smoke.mjs",
    "gen:csv": "node scripts/generate-dummy-csv.mjs"
  },
  "dependencies": {
    "@vladmandic/human": "3.3.6",
    "dexie": "4.0.11",
    "papaparse": "5.4.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.6",
    "zustand": "5.0.3"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.1.0",
    "@types/node": "22.10.2",
    "@types/papaparse": "5.3.15",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "fake-indexeddb": "6.0.0",
    "jsdom": "25.0.1",
    "playwright-core": "1.56.1",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.19",
    "typescript": "5.6.3",
    "vite": "5.4.21",
    "vite-plugin-pwa": "0.21.2",
    "vitest": "2.1.9"
  }
}
